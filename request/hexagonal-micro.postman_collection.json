{
  "info": {
    "name": "hexagonal-micro",
    "description": "Colección de endpoints de los 3 microservicios del ecommerce event-driven.\n\nPuertos:\n- catalog-service: 8082\n- order-service: 8081\n- warehouse-service: 8083\n\nEl tenant (companyId) viene del CompanyContext hardcodeado en cada micro (UUID 90000000-0000-0000-0000-000000000001).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "catalog-url",
      "value": "http://localhost:8082",
      "description": "Base URL del catalog-service"
    },
    {
      "key": "order-url",
      "value": "http://localhost:8081",
      "description": "Base URL del order-service"
    },
    {
      "key": "warehouse-url",
      "value": "http://localhost:8083",
      "description": "Base URL del warehouse-service"
    },
    {
      "key": "product-id",
      "value": "6bb88870-c472-4102-82da-656e40f9bd3b",
      "description": "UUID de un producto creado (reemplazar con el real)"
    },
    {
      "key": "order-id",
      "value": "00000000-0000-0000-0000-000000000000",
      "description": "UUID de una orden creada (reemplazar con el real)"
    },
    {
      "key": "category-id",
      "value": "00000000-0000-0000-0000-000000000000",
      "description": "UUID de una categoría creada (reemplazar con el real)"
    }
  ],
  "item": [
    {
      "name": "catalog-service",
      "description": "Catálogo de productos + categorías. Publica eventos a Kafka (topic: catalog.products).",
      "item": [
        {
          "name": "Create Product",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{catalog-url}}/api/products",
              "host": ["{{catalog-url}}"],
              "path": ["api", "products"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Notebook 16GB\",\n  \"description\": \"Laptop con 16GB de RAM y SSD 512GB\",\n  \"price\": 1500.00,\n  \"currency\": \"USD\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          },
          "response": []
        },
        {
          "name": "Get Product by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{catalog-url}}/api/products/{{product-id}}",
              "host": ["{{catalog-url}}"],
              "path": ["api", "products", "{{product-id}}"]
            }
          },
          "response": []
        },
        {
          "name": "Search Products",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{catalog-url}}/api/products?q=&page=0&size=20",
              "host": ["{{catalog-url}}"],
              "path": ["api", "products"],
              "query": [
                { "key": "q", "value": "", "description": "Texto de búsqueda (opcional)" },
                { "key": "categoryId", "value": null, "description": "UUID de categoría para filtrar (opcional)" },
                { "key": "status", "value": null, "description": "DRAFT | ACTIVE | RETIRED (opcional)" },
                { "key": "page", "value": "0", "description": "Página (default 0)" },
                { "key": "size", "value": "20", "description": "Tamaño de página (default 20)" }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Update Product",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{catalog-url}}/api/products/{{product-id}}",
              "host": ["{{catalog-url}}"],
              "path": ["api", "products", "{{product-id}}"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Notebook 32GB\",\n  \"description\": \"Laptop con 32GB de RAM y SSD 1TB\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          },
          "response": []
        },
        {
          "name": "Change Product Price",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{catalog-url}}/api/products/{{product-id}}/price",
              "host": ["{{catalog-url}}"],
              "path": ["api", "products", "{{product-id}}", "price"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"price\": 1200.00,\n  \"currency\": \"USD\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          },
          "response": []
        },
        {
          "name": "Activate Product",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{catalog-url}}/api/products/{{product-id}}/activate",
              "host": ["{{catalog-url}}"],
              "path": ["api", "products", "{{product-id}}", "activate"]
            }
          },
          "response": []
        },
        {
          "name": "Retire Product",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{catalog-url}}/api/products/{{product-id}}/retire",
              "host": ["{{catalog-url}}"],
              "path": ["api", "products", "{{product-id}}", "retire"]
            }
          },
          "response": []
        },
        {
          "name": "Assign Category to Product",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{catalog-url}}/api/products/{{product-id}}/categories/{{category-id}}",
              "host": ["{{catalog-url}}"],
              "path": ["api", "products", "{{product-id}}", "categories", "{{category-id}}"]
            }
          },
          "response": []
        },
        {
          "name": "Remove Category from Product",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{catalog-url}}/api/products/{{product-id}}/categories/{{category-id}}",
              "host": ["{{catalog-url}}"],
              "path": ["api", "products", "{{product-id}}", "categories", "{{category-id}}"]
            }
          },
          "response": []
        },
        {
          "name": "Create Category",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{catalog-url}}/api/categories",
              "host": ["{{catalog-url}}"],
              "path": ["api", "categories"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Electrónica\",\n  \"parentId\": null\n}",
              "options": { "raw": { "language": "json" } }
            }
          },
          "response": []
        },
        {
          "name": "List Categories",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{catalog-url}}/api/categories",
              "host": ["{{catalog-url}}"],
              "path": ["api", "categories"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "order-service",
      "description": "Órdenes de compra. Consume eventos de catálogo (snapshot read model). Tenant-scoped por CompanyId.",
      "item": [
        {
          "name": "Create Order",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{order-url}}/api/orders",
              "host": ["{{order-url}}"],
              "path": ["api", "orders"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"90000000-0000-0000-0000-000000000001\",\n  \"lines\": [\n    {\n      \"productId\": \"6bb88870-c472-4102-82da-656e40f9bd3b\",\n      \"quantity\": 2\n    }\n  ],\n  \"shippingAddress\": {\n    \"street\": \"Av. Siempre Viva 123\",\n    \"city\": \"Springfield\",\n    \"state\": \"\",\n    \"country\": \"AR\",\n    \"zipCode\": \"1406\"\n  },\n  \"paymentMethod\": \"CREDIT_CARD\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          },
          "response": []
        },
        {
          "name": "Get Order by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{order-url}}/api/orders/{{order-id}}",
              "host": ["{{order-url}}"],
              "path": ["api", "orders", "{{order-id}}"]
            }
          },
          "response": []
        },
        {
          "name": "Confirm Order",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{order-url}}/api/orders/{{order-id}}/confirm",
              "host": ["{{order-url}}"],
              "path": ["api", "orders", "{{order-id}}", "confirm"]
            }
          },
          "response": []
        },
        {
          "name": "Ship Order",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{order-url}}/api/orders/{{order-id}}/ship",
              "host": ["{{order-url}}"],
              "path": ["api", "orders", "{{order-id}}", "ship"]
            }
          },
          "response": []
        },
        {
          "name": "Deliver Order",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{order-url}}/api/orders/{{order-id}}/deliver",
              "host": ["{{order-url}}"],
              "path": ["api", "orders", "{{order-id}}", "deliver"]
            }
          },
          "response": []
        },
        {
          "name": "Cancel Order",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{order-url}}/api/orders/{{order-id}}/cancel",
              "host": ["{{order-url}}"],
              "path": ["api", "orders", "{{order-id}}", "cancel"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"changed my mind\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "warehouse-service",
      "description": "Stock por producto. Consume eventos de catálogo (ensureStockExists). Ledger con receive/reserve/release.",
      "item": [
        {
          "name": "Get Stock by Product ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{warehouse-url}}/api/stock/{{product-id}}",
              "host": ["{{warehouse-url}}"],
              "path": ["api", "stock", "{{product-id}}"]
            }
          },
          "response": []
        },
        {
          "name": "Get Stock Movements (Audit)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{warehouse-url}}/api/stock/{{product-id}}/movements",
              "host": ["{{warehouse-url}}"],
              "path": ["api", "stock", "{{product-id}}", "movements"]
            }
          },
          "response": []
        },
        {
          "name": "Receive Stock",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{warehouse-url}}/api/stock/{{product-id}}/receive",
              "host": ["{{warehouse-url}}"],
              "path": ["api", "stock", "{{product-id}}", "receive"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantity\": 100\n}",
              "options": { "raw": { "language": "json" } }
            }
          },
          "response": []
        },
        {
          "name": "Reserve Stock",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{warehouse-url}}/api/stock/{{product-id}}/reserve",
              "host": ["{{warehouse-url}}"],
              "path": ["api", "stock", "{{product-id}}", "reserve"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantity\": 30\n}",
              "options": { "raw": { "language": "json" } }
            }
          },
          "response": []
        },
        {
          "name": "Release Stock",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{warehouse-url}}/api/stock/{{product-id}}/release",
              "host": ["{{warehouse-url}}"],
              "path": ["api", "stock", "{{product-id}}", "release"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantity\": 10\n}",
              "options": { "raw": { "language": "json" } }
            }
          },
          "response": []
        }
      ]
    }
  ]
}